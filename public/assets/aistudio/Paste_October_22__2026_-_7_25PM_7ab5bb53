            if (element) {
                element.className = "cat-pill active-cat px-5 py-2 rounded-full text-xs sm:text-sm font-semibold border border-gold-500 bg-gold-500 text-black whitespace-nowrap transition";
            }
            renderMenu();
        }

        function handleSearchMenu() {
            searchQuery = document.getElementById('menuSearchInput').value;
            renderMenu();
        }

        function clearSearch() {
            searchQuery = '';
            document.getElementById('menuSearchInput').value = '';
            renderMenu();
        }

        function openCustomizeModal(itemId) {
            const item = menuItems.find(i => i.id === itemId);
            if (!item) return;

            selectedItemForCustomize = item;
            document.getElementById('modalDishName').textContent = item.name;
            document.getElementById('modalDishDesc').textContent = item.desc;

            const portionContainer = document.getElementById('portionContainer');
            portionContainer.innerHTML = '';

            const isPlatter = item.category === 'platters';
            const isDessert = item.category === 'desserts';

            if (isPlatter || isDessert) {
                portionContainer.innerHTML = `
                    <label class="flex justify-between items-center bg-mandi-surface p-2.5 rounded-lg border border-gold-500 cursor-pointer">
                        <span class="flex items-center gap-2">
                            <input type="radio" name="portionOpt" value="0" checked onchange="updateModalTotal()" class="accent-gold-500"> Standard Portion (${item.serves})
                        </span>
                        <span class="font-bold text-white">₹${item.price}</span>
                    </label>
                `;
            } else {
                portionContainer.innerHTML = `
                    <label class="flex justify-between items-center bg-mandi-surface p-2.5 rounded-lg border border-gold-500 cursor-pointer">
                        <span class="flex items-center gap-2">
                            <input type="radio" name="portionOpt" value="0" checked onchange="updateModalTotal()" class="accent-gold-500"> Single Portion (${item.serves})
                        </span>
                        <span class="font-bold text-white">₹${item.price}</span>
                    </label>
                    <label class="flex justify-between items-center bg-mandi-surface p-2.5 rounded-lg border border-stone-800 cursor-pointer">
                        <span class="flex items-center gap-2">
                            <input type="radio" name="portionOpt" value="280" onchange="updateModalTotal()" class="accent-gold-500"> Double Feast (Extra meat + rice)
                        </span>
                        <span class="font-bold text-white">₹${item.price + 280}</span>
                    </label>
                `;
            }

            document.getElementById('addonMayo').checked = false;
            document.getElementById('addonSoup').checked = false;
            document.getElementById('addonRice').checked = false;
            document.getElementById('addonMayo').onchange = updateModalTotal;
            document.getElementById('addonSoup').onchange = updateModalTotal;
            document.getElementById('addonRice').onchange = updateModalTotal;

            updateModalTotal();
            document.getElementById('customizeModal').classList.remove('hidden');
        }

        function closeCustomizeModal() {
            document.getElementById('customizeModal').classList.add('hidden');
            selectedItemForCustomize = null;
        }

        function updateModalTotal() {
            if (!selectedItemForCustomize) return;
            let total = selectedItemForCustomize.price;

            const selectedPortion = document.querySelector('input[name="portionOpt"]:checked');
            if (selectedPortion) {
                total += parseInt(selectedPortion.value, 10);
            }

            if (document.getElementById('addonMayo').checked) total += 30;
            if (document.getElementById('addonSoup').checked) total += 40;
            if (document.getElementById('addonRice').checked) total += 90;

            document.getElementById('modalTotalCost').textContent = `₹${total}`;
        }

        function confirmCustomizedItem() {
            if (!selectedItemForCustomize) return;

            const selectedPortion = document.querySelector('input[name="portionOpt"]:checked');
            const portionExtra = selectedPortion ? parseInt(selectedPortion.value, 10) : 0;
            const portionLabel = portionExtra > 0 ? 'Double Portion' : 'Single Portion';

            const spiceElem = document.querySelector('input[name="modalSpice"]:checked');
            const spiceVal = spiceElem ? spiceElem.value : 'Medium';

            const addons = [];
            let addonCost = 0;
            if (document.getElementById('addonMayo').checked) { addons.push('Mayo'); addonCost += 30; }
            if (document.getElementById('addonSoup').checked) { addons.push('Shorba'); addonCost += 40; }
            if (document.getElementById('addonRice').checked) { addons.push('Extra Rice'); addonCost += 90; }

            const unitPrice = selectedItemForCustomize.price + portionExtra + addonCost;
            const cartItemId = `${selectedItemForCustomize.id}_${portionLabel}_${spiceVal}_${addons.join('-')}`;

            const existing = cart.find(i => i.uid === cartItemId);
            if (existing) {
                existing.quantity += 1;
            } else {
                cart.push({
                    uid: cartItemId,
                    id: selectedItemForCustomize.id,
                    name: selectedItemForCustomize.name,
                    price: unitPrice,
                    quantity: 1,
                    portion: portionLabel,
                    spice: spiceVal,
                    addons: addons,
                    image: selectedItemForCustomize.image
                });
            }

            closeCustomizeModal();
            updateCartUI();
            toggleCartDrawer(true);
        }

        function addToCartDirect(itemId) {
            openCustomizeModal(itemId);
        }

        function toggleCartDrawer(open) {
            const drawer = document.getElementById('cartDrawer');
            if (open) {
                drawer.classList.remove('translate-x-full');
            } else {
                drawer.classList.add('translate-x-full');
            }
        }

        function setOrderType(type) {
            orderType = type;
            ['delivery', 'takeaway', 'dinein'].forEach(t => {
                const btn = document.getElementById(`type${t.charAt(0).toUpperCase() + t.slice(1)}`);
                if (t === type) {
                    btn.className = "py-1.5 rounded-lg bg-gold-500 text-black font-bold";
                } else {
                    btn.className = "py-1.5 rounded-lg hover:text-white";
                }
            });

            const addrContainer = document.getElementById('addressFieldContainer');
            const packingLabel = document.getElementById('packingLabel');
            if (type === 'delivery') {
                if (addrContainer) addrContainer.style.display = 'block';
                packingLabel.textContent = 'Delivery & Packaging Fee';
            } else {
                if (addrContainer) addrContainer.style.display = 'none';
                packingLabel.textContent = type === 'takeaway' ? 'Eco Takeaway Box Fee' : 'Table Service';
            }
            updateCartUI();
        }

        function changeItemQty(uid, delta) {
            const item = cart.find(i => i.uid === uid);
            if (!item) return;

            item.quantity += delta;
            if (item.quantity <= 0) {
                cart = cart.filter(i => i.uid !== uid);
            }
            updateCartUI();
        }

        function applyCoupon() {
            const code = document.getElementById('couponInput').value.trim().toUpperCase();
            const msg = document.getElementById('couponMsg');

            if (code === 'TOLLYWOOD15') {
                appliedCoupon = { code: 'TOLLYWOOD15', rate: 0.15 };
                msg.textContent = '🎬 Blockbuster 15% discount applied successfully!';
                msg.className = 'text-[11px] text-emerald-400 font-semibold block';
            } else {
                appliedCoupon = null;
                msg.textContent = 'Invalid coupon code. Try TOLLYWOOD15.';
                msg.className = 'text-[11px] text-red-400 font-semibold block';
            }
            updateCartUI();
        }

        function updateCartUI() {
            const badge = document.getElementById('cartCountBadge');
            const totalCount = cart.reduce((acc, curr) => acc + curr.quantity, 0);
            badge.textContent = totalCount;

            const list = document.getElementById('cartItemsList');
            const subtotalElem = document.getElementById('cartSubtotal');
            const taxElem = document.getElementById('cartTax');
            const totalElem = document.getElementById('cartTotal');
            const packingElem = document.getElementById('cartPacking');
            const discountRow = document.getElementById('discountRow');
            const discountElem = document.getElementById('cartDiscount');

            if (cart.length === 0) {
                list.innerHTML = `
                    <div class="text-center py-16 space-y-3">
                        <i class="fa-solid fa-utensils text-4xl text-stone-600"></i>
                        <p class="text-stone-400 text-xs">Your royal plate is currently empty.</p>
                        <a href="#menu" onclick="toggleCartDrawer(false)" class="inline-block text-gold-400 text-xs font-semibold hover:underline">Explore Blockbuster Menu</a>
                    </div>
                `;
                subtotalElem.textContent = '₹0';
                taxElem.textContent = '₹0';
                totalElem.textContent = '₹0';
                packingElem.textContent = '₹0';
                discountRow.style.display = 'none';
                return;
            }

            list.innerHTML = '';
            let subtotal = 0;

            cart.forEach(item => {
                const itemTotal = item.price * item.quantity;
                subtotal += itemTotal;

                const row = document.createElement('div');
                row.className = "flex items-center justify-between bg-mandi-surface p-3 rounded-xl border border-stone-800 gap-2";
                row.innerHTML = `
                    <div class="flex items-center gap-3 flex-1 min-w-0">
                        <img src="${item.image}" alt="${item.name}" onerror="this.src='https://placehold.co/100x100/1F100B/D4AF37?text=Food'" class="w-12 h-12 rounded-lg object-cover flex-shrink-0">
                        <div class="truncate">
                            <h4 class="text-xs font-bold text-white truncate">${item.name}</h4>
                            <p class="text-[10px] text-stone-400">${item.portion} • ${item.spice}${item.addons.length ? ' • ' + item.addons.join('+') : ''}</p>
                            <span class="text-[11px] text-gold-400 font-bold">₹${item.price} each</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 flex-shrink-0">
                        <button onclick="changeItemQty('${item.uid}', -1)" class="w-6 h-6 rounded bg-stone-800 text-white hover:bg-gold-500 hover:text-black text-xs font-bold transition flex items-center justify-center">-</button>
                        <span class="text-xs font-bold text-white px-1">${item.quantity}</span>
                        <button onclick="changeItemQty('${item.uid}', 1)" class="w-6 h-6 rounded bg-stone-800 text-white hover:bg-gold-500 hover:text-black text-xs font-bold transition flex items-center justify-center">+</button>
                    </div>
                `;
                list.appendChild(row);
            });

            let discount = 0;
            if (appliedCoupon) {
                discount = Math.round(subtotal * appliedCoupon.rate);
                discountRow.style.display = 'flex';
                discountElem.textContent = `-₹${discount}`;
            } else {
                discountRow.style.display = 'none';
            }

            const taxable = subtotal - discount;
            const tax = Math.round(taxable * 0.05);
            const packing = orderType === 'delivery' ? 35 : (orderType === 'takeaway' ? 25 : 0);
            const grandTotal = taxable + tax + packing;

            subtotalElem.textContent = `₹${subtotal}`;
            taxElem.textContent = `₹${tax}`;
            packingElem.textContent = `₹${packing}`;
            totalElem.textContent = `₹${grandTotal}`;

            const modalPayable = document.getElementById('modalPayableTotal');
            if (modalPayable) {
                modalPayable.textContent = `Total: ₹${grandTotal}`;
            }

            // Update QR code with exact amount
            const upiQr = document.getElementById('upiQrImage');
            if (upiQr) {
                upiQr.src = `https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=upi://pay?pa=9866615115@ybl%26pn=TollywoodMandi%26am=${grandTotal}%26cu=INR`;
            }
        }

        // Custom in-app notification toast (Replaces window.alert)
        function showNotification(title, message, isError = false) {
            const toast = document.getElementById('toastNotification');
            const toastTitle = document.getElementById('toastTitle');
            const toastMessage = document.getElementById('toastMessage');
            const toastIcon = document.getElementById('toastIcon');

            if (!toast) return;

            toastTitle.textContent = title;
            toastMessage.textContent = message;

            if (isError) {
                toastIcon.className = "w-8 h-8 rounded-full bg-red-500/20 text-red-400 flex items-center justify-center flex-shrink-0 text-sm";
                toastIcon.innerHTML = `<i class="fa-solid fa-circle-exclamation"></i>`;
                toast.classList.add('border-red-500/50');
                toast.classList.remove('border-gold-500/60');
            } else {
                toastIcon.className = "w-8 h-8 rounded-full bg-gold-500/20 text-gold-400 flex items-center justify-center flex-shrink-0 text-sm";
                toastIcon.innerHTML = `<i class="fa-solid fa-circle-check"></i>`;
                toast.classList.add('border-gold-500/60');
                toast.classList.remove('border-red-500/50');
            }

            toast.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-24', 'opacity-0', 'pointer-events-none');
            }, 3500);
        }

        function orderViaWhatsApp() {
            if (cart.length === 0) {
                showNotification("Plate is Empty", "Please select and add some items to your feast plate first!", true);
                return;
            }

            let subtotal = 0;
            let receipt = `*🎬 NEW ORDER - TOLLYWOOD MANDI (SR NAGAR)*%0A`;
            receipt += `*Type:* ${orderType.toUpperCase()}%0A%0A`;

            cart.forEach((i, idx) => {
                const cost = i.price * i.quantity;
                subtotal += cost;
                receipt += `${idx + 1}. *${i.name}* (${i.portion})%0A`;
                receipt += `   • Spice: ${i.spice}${i.addons.length ? ' | Extras: ' + i.addons.join(', ') : ''}%0A`;
                receipt += `   • Qty: ${i.quantity} x ₹${i.price} = *₹${cost}*%0A%0A`;
            });

            let discount = appliedCoupon ? Math.round(subtotal * appliedCoupon.rate) : 0;
            const taxable = subtotal - discount;
            const tax = Math.round(taxable * 0.05);
            const packing = orderType === 'delivery' ? 35 : (orderType === 'takeaway' ? 25 : 0);
            const total = taxable + tax + packing;

            receipt += `----------------------------%0A`;
            receipt += `*Subtotal:* ₹${subtotal}%0A`;
            if (discount > 0) receipt += `*Discount (TOLLYWOOD15):* -₹${discount}%0A`;
            receipt += `*GST (5%):* ₹${tax}%0A`;
            receipt += `*Packaging / Delivery:* ₹${packing}%0A`;
            receipt += `*Total Payable:* *₹${total}*%0A`;
            receipt += `----------------------------%0A`;
            receipt += `📍 *Outlet:* Venkat's Building, 1st Floor, SR Nagar, Ameerpet, Hyderabad%0A`;
            receipt += `Please confirm order preparation and dispatch time!`;

            const waUrl = `https://wa.me/${RESTAURANT_PHONE}?text=${receipt}`;
            window.open(waUrl, '_blank');
        }

        function openInstantUPIModal() {
            if (cart.length === 0) {
                showNotification("Cart is Empty", "Add your favorite Mandi items before proceeding to checkout.", true);
                return;
            }
            updateCartUI();
            document.getElementById('upiModal').classList.remove('hidden');
        }

        function closeInstantUPIModal() {
            document.getElementById('upiModal').classList.add('hidden');
        }

        function completePayment(method) {
            const name = document.getElementById('custName').value.trim() || 'Valued Guest';
            const phone = document.getElementById('custPhone').value.trim();
            const address = document.getElementById('custAddress').value.trim();

            if (!phone) {
                showNotification("Phone Number Required", "Please enter your mobile or WhatsApp number so we can reach you!", true);
                return;
            }

            const orderId = 'TM-' + Math.floor(100000 + Math.random() * 900000);
            let subtotal = 0;
            cart.forEach(i => subtotal += (i.price * i.quantity));
            let discount = appliedCoupon ? Math.round(subtotal * appliedCoupon.rate) : 0;
            const tax = Math.round((subtotal - discount) * 0.05);
            const packing = orderType === 'delivery' ? 35 : 0;
            const total = (subtotal - discount) + tax + packing;

            let msg = `*🎬 ORDER CONFIRMATION - TOLLYWOOD MANDI*%0A`;
            msg += `*Order ID:* ${orderId}%0A`;
            msg += `*Customer:* ${name} (${phone})%0A`;
            msg += `*Order Type:* ${orderType.toUpperCase()}%0A`;
            if (orderType === 'delivery' && address) {
                msg += `*Address:* ${address}%0A`;
            }
            msg += `*Payment Method:* ${method}%0A`;
            msg += `*Total Paid/Due:* ₹${total}%0A%0A`;
            msg += `*Items Ordered:*%0A`;
            cart.forEach(i => {
                msg += `• ${i.name} (${i.portion}, ${i.spice}) x ${i.quantity}%0A`;
            });
            msg += `%0AOrder recorded! Kitchen is preparing your royal Mandi.`;

            closeInstantUPIModal();
            toggleCartDrawer(false);
            cart = [];
            updateCartUI();

            showNotification("Order Confirmed!", `Order ${orderId} received. Forwarding to WhatsApp desk.`);
            setTimeout(() => {
                window.open(`https://wa.me/${RESTAURANT_PHONE}?text=${msg}`, '_blank');
            }, 800);
        }

        function handleReservationSubmit(e) {
            e.preventDefault();

            const name = document.getElementById('resName').value.trim();
            const phone = document.getElementById('resPhone').value.trim();
            const date = document.getElementById('resDate').value;
            const time = document.getElementById('resTime').value;
            const guests = document.getElementById('resGuests').value;
            const seating = document.getElementById('resSeating').value;
            const notes = document.getElementById('resNotes').value.trim();

            let msg = `*👑 NEW MAJLIS RESERVATION - TOLLYWOOD MANDI*%0A%0A`;
            msg += `*Guest Name:* ${name}%0A`;
            msg += `*Phone:* ${phone}%0A`;
            msg += `*Date:* ${date}%0A`;
            msg += `*Time Slot:* ${time}%0A`;
            msg += `*Guests:* ${guests}%0A`;
            msg += `*Seating:* ${seating}%0A`;
            if (notes) msg += `*Special Request:* ${notes}%0A`;
            msg += `%0A📍 *Outlet:* Venkat's Building, 1st Floor, SR Nagar, Ameerpet, Hyderabad%0A`;
            msg += `Please reserve and confirm our cabin!`;

            showNotification("Reservation Sent!", `Thank you ${name}! Sending your details to the SR Nagar front desk.`);
            setTimeout(() => {
                window.open(`https://wa.me/${RESTAURANT_PHONE}?text=${msg}`, '_blank');
            }, 800);

            e.target.reset();
            document.getElementById('resDate').value = todayStr;
        }

        function toggleMobileNav() {
            const nav = document.getElementById('mobileNav');
            nav.classList.toggle('hidden');
        }

        // Initialize Menu on Load
        window.onload = function() {
            renderMenu();
            updateCartUI();
        };
    </script>
